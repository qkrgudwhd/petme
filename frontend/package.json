{
  "name": "petme-moji-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "cross-env NEXT_OUTPUT=export NEXT_PUBLIC_API_BASE=$BACKEND_URL next build",
    "start": "next start",
    "lint": "next lint",
    "cap:init": "cap init PetMe-Moji com.petmemoji.app",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2"
  }
}
